{
  "name": "athleteverse",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": ">=22.22.0"
  },
  "scripts": {
    "dev:api": "npm run dev -w @athleteverse/api --",
    "dev:web": "npm run dev -w @athleteverse/web --",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:generate": "npm run db:generate -w @athleteverse/api --",
    "db:init": "npm run db:init -w @athleteverse/api --",
    "db:migrate": "npm run db:migrate -w @athleteverse/api --",
    "db:deploy": "npm run db:deploy -w @athleteverse/api --",
    "db:seed": "npm run db:seed -w @athleteverse/api --",
    "lint": "eslint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}
