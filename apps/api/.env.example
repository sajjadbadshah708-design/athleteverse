# Copy to apps/api/.env  (never commit .env)
# Local Postgres from docker-compose. For Neon use the pooled URL in DATABASE_URL and the direct URL in DIRECT_URL.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/athleteverse
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/athleteverse
# Tests TRUNCATE every table: the database name MUST end with _test
TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/athleteverse_test

# API server
PORT=3000
# LOG_LEVEL=info                 # debug | info | warn | error | silent (default: silent in tests, info otherwise)
PLATFORM_TZ=UTC                  # IANA zone of the launch city (OI-1); UTC until it is answered
TRUST_PROXY_HOPS=0               # set after spike S2 measures the Vercel -> Render chain (docs/DEPLOY.md)
JOB_SECRET=dev-job-secret-change-me-0123456789abcdef   # >= 32 chars; header X-Job-Secret for POST /api/jobs/tick. REQUIRED in production
# ENABLE_SPIKES=false            # true only while running spike S2

# Authentication (T5). In production JWT_SECRET, OTP_PEPPER and MAIL_PROVIDER are REQUIRED (>= 32 characters each for the secrets).
# Without them development uses fixed insecure values, which is fine on your own machine and nowhere else.
# JWT_SECRET=
# OTP_PEPPER=
# BCRYPT_COST=10                 # tests use 4
MAIL_PROVIDER=console            # console | brevo | resend. "console" prints e-mails (and so the verification codes) to the API log

# Seed (prisma/seed.ts). OWNER_* are required when NODE_ENV=production. Demo data is off in production.
OWNER_EMAIL=owner@athleteverse.test
OWNER_PHONE=920000000000
OWNER_PASSWORD=ChangeMe12345
# SEED_DEMO=true
# SEED_PASSWORD=Demo12345

# Added in later tasks: JWT_SECRET, OTP_PEPPER, JOB_SECRET, PLATFORM_TZ, MAIL_*, WEB_BASE_URL

# For brevo or resend (also read by npm run spike:mail, docs/DEPLOY.md S3):
# MAIL_API_KEY=
# MAIL_FROM="AthleteVerse <your validated sender>"

# Base URL for 48-hour staff invitation links
WEB_BASE_URL=http://localhost:5173
