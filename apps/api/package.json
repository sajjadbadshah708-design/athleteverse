{
  "name": "@athleteverse/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node --import tsx src/server.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:integrity": "node scripts/install-integrity-migration.mjs",
    "db:init": "prisma migrate dev --name init && node scripts/install-integrity-migration.mjs && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "spike:db": "tsx scripts/spikes/db.ts",
    "spike:mail": "tsx scripts/spikes/mail.ts"
  },
  "prisma": {
    "schema": "prisma/schema.prisma",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@athleteverse/shared": "*",
    "@prisma/adapter-pg": "6.19.3",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.3",
    "cookie": "^2.0.1",
    "dotenv": "^17.2.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jose": "^6.2.13",
    "pg": "^8.16.3",
    "tsx": "^4.20.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "prisma": "6.19.3",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5",
    "yaml": "^2.8.1"
  }
}
